# 构建产物与本地发布包（统一放 dist/）
dist/
packaging/fpk/app/bin/
backups/

# 本地数据
*.db
*.db-wal
*.db-shm

# 临时文件
*.log
.DS_Store
.screenshots/

# 本地需求草稿与工作笔记
/cache/

# Agent 工作记忆，不进版本库
.workbuddy/

# Hallmark 本地审计产物（截图/记录），不进版本库
.hallmark/
**/.hallmark/

# Agent 工具工作目录（本地缓存，2026-11-13 重构补规则）
.box-agent/
.box-agent-scratch/

# cache\ 的等价临时目录名（规范第 2 节），重建后同样忽略
/tmp/

# 项目状态卡属本地工作状态，按 2026-11-13 口径放项目根且不入库（只忽略根上这一份）
/项目状态卡.md

# 本地二进制与覆盖率产物
/verify
/verify.exe
coverage.out

# 本地运行配置与凭据（config.json 内含访问令牌，不进版本库）
/config.json
.env

# 根目录误留的安装包：正式产物统一输出到 dist/
/*.fpk

