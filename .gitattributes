# 统一换行符：仓库内文本一律 LF，避免 Windows(autocrlf) 与 Linux 构建机产生整文件 diff
* text=auto eol=lf

# Go / 配置 / 文档显式声明为文本
*.go   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# 二进制资源不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.svg  text eol=lf
*.fpk  binary
*.db   binary
*.exe  binary
