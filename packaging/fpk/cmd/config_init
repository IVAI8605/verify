#!/bin/bash

### 配置前钩子：fnpack 1.2.3 不强制要求，但保留飞牛模板默认结构，便于系统改环境变量时被调用。
### 设置项全部存在应用自己的 config.json 与 SQLite，无需改写系统配置，只留一行时间戳。

MSG="$(date '+%Y-%m-%d %H:%M') config_init：配置前无额外动作（设置存应用自身配置）"
echo "$MSG" >> /tmp/verify-fpk-hook.log 2>/dev/null
[ -n "${TRIM_TEMP_LOGFILE}" ] && echo "$MSG" >> "${TRIM_TEMP_LOGFILE}" 2>/dev/null

exit 0
