appname=verify
version=4.5.0
display_name=查重助手
desc=飞牛 NAS 重复文件清理与实时查重助手：按文件内容精确查重、同名文件分组、视频相似检测、相同片头检测（1–300 秒可调），支持隔离区恢复与 Duplicate Cleaner 兼容 CSV 导出。视频分析复用系统 FFmpeg，可选用 Intel 核显 QSV 硬解加速。
platform=x86
source=thirdparty
maintainer=Verify
maintainer_url=https://github.com/IVAI8605/verify
distributor=Verify
os_min_version=1.2.1000
service_port=${wizard_port}
checkport=true
ctl_stop=true
changelog=安装时可选端口：安装向导第一步即可指定 Web 访问端口（默认 18898，避开 8898、8080 等常被占用的端口），端口冲突不再导致装不上。升级时同样会确认端口，默认 18898；想保持在 8898 的旧实例把它填回即可。程序默认监听端口同步改为 18898（可用 --addr 或配置覆盖）。
desktop_uidir=ui
desktop_applaunchname=verify.Application
